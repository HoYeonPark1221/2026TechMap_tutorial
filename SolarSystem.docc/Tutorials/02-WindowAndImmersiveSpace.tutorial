@Tutorial(time: 25, projectFiles: "SolarSystem-StartingProject.zip") {
    @XcodeRequirement(title: "Xcode 26 이상, visionOS 26 SDK", destination: "https://developer.apple.com/xcode/")

    @Intro(title: "창과 몰입 공간 오가기") {
        이 앱에는 상태가 두 가지뿐입니다. 창만 떠 있는 공유 공간과, 주변이 전부 우주로
        덮이는 전체 몰입 공간입니다. 그 사이를 오가는 길을 이 챕터에서 만듭니다.

        몰입 스타일은 늘 `.full` 하나입니다. 그래서 전환이란 "스타일을 바꾸는 일"이
        아니라 **몰입 공간을 여느냐 닫느냐**입니다. 여닫는 동안 생기는 중간 상태,
        그 상태를 어디서 기록해야 하는지, 창이 투명해지려면 무엇이 필요한지를 차례로
        다룹니다.

        1챕터에서 만든 `SwitchWindows`에 상태 배선을 붙이고, `@main` 진입점에서 창과
        몰입 공간을 Scene으로 등록하면 앱이 끝까지 돕니다.
    }

    @Section(title: "전환 중이라는 상태 만들기") {
        @ContentAndMedia {
            몰입 공간을 여닫는 일은 `await`라서 시간이 걸립니다. 그 사이에 버튼이 또
            눌리면 공간이 두 번 열리거나 상태가 어긋납니다.

            그래서 "열림"과 "닫힘" 사이에 **"전환 중"**을 하나 더 둡니다. 값이 세 개인
            열거형 하나가 이 문제를 통째로 막아 줍니다.

            @Image(source: "diagram-asset-bundle.svg", alt: "창과 몰입 공간이 같은 상태 객체를 공유하는 구조도")
        }

        @Steps {
            @Step {
                `Model` 폴더의 `AppModel.swift`를 엽니다. 포커스와 머리 추적에 쓰는
                상태는 이미 들어 있습니다.
                @Code(name: "AppModel.swift", file: "02-01-AppModel.swift")
            }

            @Step {
                맨 위에 몰입 공간용 상태를 더합니다.
                @Code(name: "AppModel.swift", file: "02-02-AppModel.swift", previousFile: "02-01-AppModel.swift")

                `immersiveSpaceID`는 공간을 열고 닫을 때 쓰는 이름입니다. 뒤에서 선언할
                `ImmersiveSpace(id:)`와 반드시 같은 값이어야 하므로, 양쪽이 같은 상수를
                보게 여기에 둡니다. `isShowingSolar`는 창에 무엇을 보일지 정하는
                값입니다.
            }

            @Step {
                1챕터에서 빼 두었던 `SolarSystemControls.swift`를 이제 프로젝트의
                `Solar System` 폴더로 옮깁니다.

                아직 빌드되지 않습니다. 이 파일과 `SolarCard`가 기다리는
                `ToggleImmersiveSpaceButton`을 다음 섹션에서 만듭니다.
            }
        }
    }

    @Section(title: "여닫는 버튼 만들기") {
        @ContentAndMedia {
            `openImmersiveSpace`와 `dismissImmersiveSpace`는 환경값으로 들어옵니다.
            버튼이 할 일은 지금 상태를 보고 둘 중 하나를 고르는 것뿐입니다.

            여는 쪽에는 한 가지가 더 있습니다. `openImmersiveSpace`는 성공뿐 아니라
            사용자 취소와 오류도 돌려줍니다. 실패했을 때 상태를 되돌려 놓지 않으면
            버튼이 "전환 중"에 영원히 묶입니다.

            @Image(source: "app-starfield.png", alt: "창의 버튼으로 몰입 공간을 연 화면")
        }

        @Steps {
            @Step {
                `Solar System` 폴더에 `ToggleImmersiveSpaceButton.swift`를 만듭니다.
                @Code(name: "ToggleImmersiveSpaceButton.swift", file: "02-03-ToggleImmersiveSpaceButton.swift")

                세 갈래 모두 먼저 `.inTransition`으로 바꾸는 것이 핵심입니다. 그런데
                여닫기가 끝난 뒤에 `.open`이나 `.closed`로 바꾸는 코드는 여기 없습니다.
                몰입 공간에 이르는 경로가 버튼 하나가 아니기 때문입니다. 사용자가 시스템
                제스처로 닫을 수도 있고, 다른 코드가 열 수도 있습니다. 그래서 실제
                열림·닫힘은 공간 자신이 나타나고 사라질 때 기록합니다. 다음 섹션에서
                `SolarSystem`의 `onAppear`와 `onDisappear`가 그 일을 합니다.
            }

            @Step {
                전환 중에는 버튼을 잠급니다.
                @Code(name: "ToggleImmersiveSpaceButton.swift", file: "02-04-ToggleImmersiveSpaceButton.swift", previousFile: "02-03-ToggleImmersiveSpaceButton.swift")

                `.inTransition` 갈래가 `break`만 하고 끝나는 것은 이 `disabled` 덕분에
                그 갈래에 도달할 일이 없기 때문입니다.
            }

            @Step {
                **Command + B**로 빌드합니다. 1챕터 끝에 남겨 둔 두 오류가 모두
                사라지고 전체가 통과해야 합니다.

                아직 실행해도 창에는 자리 표시용 글자만 나옵니다. 창을 채우는 일은
                마지막 섹션에서 합니다.
            }
        }
    }

    @Section(title: "열림과 닫힘을 공간 자신이 기록하기") {
        @ContentAndMedia {
            몰입 공간 안에 들어갈 내용은 이미 `SolarSystem.swift`에 쌓여 있습니다.
            별 배경, 태양, 여덟 행성, 그리고 1챕터에서 만든 포커스 레이아웃입니다.

            여기에 붙일 것은 생명주기입니다. 공간이 나타나면 `.open`, 사라지면
            `.closed`로 기록합니다. 버튼이 아니라 이 자리에 두는 이유는, 공간이 열리고
            닫히는 경로가 버튼 말고도 있기 때문입니다.

            @Image(source: "app-solarsystem.png", alt: "몰입 공간에 펼쳐진 태양계 화면")
        }

        @Steps {
            @Step {
                `Solar System` 폴더의 `SolarSystem.swift`를 엽니다.
                @Code(name: "SolarSystem.swift", file: "02-05-SolarSystem.swift")

                포커스 레이아웃을 시선 정면에 놓는 부분은 제공된 채로 들어 있습니다.
                `model.focusPlacement`가 핀치하는 순간 읽은 머리 위치이고, 레이아웃이
                행성과 창을 서로 맞춰 놓으므로 그 묶음의 중심만 그 자리로 옮기면
                됩니다.
            }

            @Step {
                생명주기를 붙입니다.
                @Code(name: "SolarSystem.swift", file: "02-06-SolarSystem.swift", previousFile: "02-05-SolarSystem.swift")

                `onAppear`와 `onDisappear`가 `immersiveSpaceState`와 `isShowingSolar`를
                동시에 바꿉니다. 머리 추적은 몰입 공간이 열려 있는 동안만 데이터가
                오므로 여기서 시작하고 멈춥니다.
            }

            @Step {
                1챕터에서 만든 `SwitchWindows`에 `isShowingSolar` 배선을 붙입니다.
                @Code(name: "SwitchWindows.swift", file: "02-07-SwitchWindows.swift", previousFile: "01-02-SwitchWindows.swift")

                두 뷰가 `SpatialContainer` 안에서 같은 자리를 차지한 채 불투명도만
                서로 반대로 움직입니다. 몰입 공간에 들어가면 컨트롤이, 나오면 소개
                카드가 보입니다.
            }
        }
    }

    @Section(title: "@main에서 두 Scene 잇기") {
        @ContentAndMedia {
            창과 몰입 공간은 서로 다른 Scene이라 직접 대화하지 못합니다. 같은
            `@Observable` 객체 하나를 양쪽에 주입해야 한쪽의 변화가 다른 쪽에 비칩니다.

            여기서 몰입 스타일도 정합니다. `immersionStyle(selection:in:)`에 넘기는
            허용 집합이 `.full` 하나뿐이라, 이 앱의 몰입 공간은 다른 스타일로 바뀌지
            않습니다.

            @Image(source: "app-sun.png", alt: "전체 몰입 공간에서 태양을 바라보는 화면")
        }

        @Steps {
            @Step {
                `SolarSystemApp.swift`를 엽니다. 직접 만든 RealityKit 시스템을
                등록하는 `init()`은 이미 들어 있습니다.
                @Code(name: "SolarSystemApp.swift", file: "02-08-SolarSystemApp.swift")
            }

            @Step {
                `AppModel`을 한 번만 만들고, 자리 표시용 `Text`를 `SwitchWindows`로
                바꾸면서 주입합니다.
                @Code(name: "SolarSystemApp.swift", file: "02-09-SolarSystemApp.swift", previousFile: "02-08-SolarSystemApp.swift")

                `.windowStyle(.plain)`이 없으면 시스템이 창에 유리 배경을 깝니다. 그
                배경은 `opacity`가 적용되는 대상이 아니라서, 소개 카드를 투명하게 만들어도
                배경만 남아 사라지지 않습니다. `SolarCard`가 자기 유리 배경을 직접
                거는 것도 같은 이유입니다.
            }

            @Step {
                `ImmersiveSpace` Scene을 더하고 같은 `model`을 주입합니다.
                @Code(name: "SolarSystemApp.swift", file: "02-10-SolarSystemApp.swift", previousFile: "02-09-SolarSystemApp.swift")

                `id`가 `ToggleImmersiveSpaceButton`이 `openImmersiveSpace(id:)`에
                넘기는 값과 같아야 합니다. 둘 다 `model.immersiveSpaceID`를 보므로
                어긋날 일이 없습니다. 다르면 아무 오류 없이 그냥 열리지 않습니다.
            }

            @Step {
                1챕터에서 받아 쓴 `Info.plist`를 열어
                `UISceneInitialImmersionStyle`을 확인합니다. 값이
                `UIImmersionStyleMixed`입니다.

                이 값과 방금 쓴 `.full`이 서로 다른 것은 문제가 아닙니다.
                `UISceneInitialImmersionStyle`은 공간이 뜨는 **첫 순간의 스타일**일
                뿐이고, 실제 스타일은 `immersionStyle(selection:in:)`이 정합니다. 허용
                집합이 `.full` 하나뿐이라 이 앱은 곧바로 전체 몰입이 됩니다.
            }

            @Step {
                **Command + R**로 실행합니다. 창의 버튼으로 태양계를 열고, 행성을
                바라보며 손가락을 맞대 보세요.
                @Image(source: "app-focus-mars.png", alt: "확대된 행성 옆에 설명 패널이 떠 있는 화면")

                1챕터에서 만든 레이아웃이 여기서 처음 눈에 보입니다. 토성을 집어 보면
                고리가 퍼진 만큼 설명 창이 더 밀려나는 것을, 수성을 집어 보면 창이
                바짝 붙는 것을 확인할 수 있습니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            `ImmersiveSpaceState`에 `.inTransition`을 둔 이유는 무엇인가요?

            @Choice(isCorrect: true) {
                여닫기가 끝나기 전에 버튼이 다시 눌리는 것을 막기 위해서입니다.

                @Justification(reaction: "맞습니다!") {
                    `openImmersiveSpace`와 `dismissImmersiveSpace`는 `await`라서 시간이 걸립니다. 그 사이를 중간 상태로 덮고 버튼을 잠급니다.
                }
            }

            @Choice(isCorrect: false) {
                몰입 스타일이 mixed에서 full로 바뀌는 동안을 나타내기 위해서입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    이 앱의 허용 스타일은 `.full` 하나뿐이라 스타일이 바뀌는 일 자체가 없습니다.
                }
            }

            @Choice(isCorrect: false) {
                몰입 공간이 열리는 애니메이션 길이를 재기 위해서입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    시간을 재는 값이 아니라, 버튼을 잠글 구간을 나타내는 상태입니다.
                }
            }
        }

        @MultipleChoice {
            `.open`과 `.closed`를 버튼이 아니라 `SolarSystem`의 `onAppear`/`onDisappear`에서 기록하는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                버튼에서는 `@Observable` 객체를 수정할 수 없기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    버튼도 수정합니다. 실제로 `.inTransition`은 버튼이 기록합니다.
                }
            }

            @Choice(isCorrect: true) {
                몰입 공간이 열리고 닫히는 경로가 버튼 말고도 있기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    사용자가 시스템 제스처로 닫을 수도 있습니다. 공간 자신이 기록하면 어느 경로로 바뀌든 상태가 어긋나지 않습니다.
                }
            }

            @Choice(isCorrect: false) {
                `openImmersiveSpace`가 성공 여부를 돌려주지 않기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    돌려줍니다. 그 결과는 실패했을 때 `.closed`로 되돌리는 데 씁니다.
                }
            }
        }

        @MultipleChoice {
            `Info.plist`의 `UISceneInitialImmersionStyle`이 `UIImmersionStyleMixed`인데 앱이 전체 몰입으로 뜨는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                `Info.plist` 값이 잘못되어 무시되고 있기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    잘못된 값이 아닙니다. 공간이 뜨는 첫 순간의 스타일로 실제로 쓰입니다.
                }
            }

            @Choice(isCorrect: true) {
                `UISceneInitialImmersionStyle`은 초기 스타일일 뿐이고, 실제 스타일은 `immersionStyle(selection:in:)`이 정하기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    허용 집합이 `.full` 하나뿐이라 공간이 뜨자마자 전체 몰입이 됩니다. 두 값이 달라 보이는 것은 역할이 다르기 때문입니다.
                }
            }

            @Choice(isCorrect: false) {
                visionOS 26부터 mixed 스타일이 사라졌기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    mixed는 그대로 있습니다. 이 앱이 허용 집합에 넣지 않았을 뿐입니다.
                }
            }
        }

        @MultipleChoice {
            `@main`에 `.windowStyle(.plain)`을 주지 않으면 어떤 일이 생기나요?

            @Choice(isCorrect: false) {
                창이 아예 뜨지 않습니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    창은 뜹니다. 문제는 창에 깔리는 배경입니다.
                }
            }

            @Choice(isCorrect: true) {
                시스템이 깐 유리 배경이 `opacity`의 적용 대상이 아니라, 소개 카드를 투명하게 만들어도 배경이 남습니다.

                @Justification(reaction: "맞습니다!") {
                    그래서 창 배경을 시스템에 맡기지 않고, `SolarCard`가 자기 유리 배경을 직접 겁니다.
                }
            }

            @Choice(isCorrect: false) {
                `SpatialContainer`가 자식을 겹쳐 두지 못합니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    겹쳐 두는 일은 창 스타일과 관계없이 그대로 동작합니다.
                }
            }
        }
    }
}
