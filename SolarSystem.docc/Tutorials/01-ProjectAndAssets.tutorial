@Tutorial(time: 15, projectFiles: "SolarSystem-Assets.zip") {
    @XcodeRequirement(title: "Xcode 26 이상, visionOS 26 SDK", destination: "https://developer.apple.com/xcode/")

    @Intro(title: "프로젝트와 에셋 준비하기") {
        새 visionOS 앱을 만들고, 태양과 여덟 행성 모델·별 배경·조명 이미지를 프로젝트에
        연결합니다.

        이 챕터에서는 코드를 쓰지 않습니다. 하지만 다음 챕터부터 쓰는 모든 코드가 여기서
        연결한 에셋 이름을 그대로 참조하므로, 반드시 먼저 끝내야 합니다.
    }

    @Section(title: "새 visionOS 앱 만들기") {
        @ContentAndMedia {
            Xcode 26 이상에서 시작합니다. 앱 템플릿이 만들어 주는 기본 파일 가운데
            `ContentView.swift`, `ImmersiveView.swift`, `AppModel.swift`,
            `ToggleImmersiveSpaceButton.swift`는 이 튜토리얼에서 쓰지 않습니다. 뒤의 둘은
            3·4챕터에서 같은 이름으로 직접 만들기 때문에, 남겨 두면 `Invalid
            redeclaration` 오류가 납니다. 네 개를 이 섹션에서 한꺼번에 지웁니다.

            최소 배포 대상은 **visionOS 26.0**입니다. 3챕터에서 쓰는 `SpatialContainer`와
            `depthAlignment`가 visionOS 26부터 제공되기 때문입니다.

            @Image(source: "xcode-new-project-template.png", alt: "Xcode의 새 프로젝트 템플릿 선택 화면")
        }

        @Steps {
            @Step {
                Xcode에서 **File ▸ New ▸ Project**를 엽니다. **visionOS** 탭의 **App**을
                선택하고 **Next**를 누릅니다.
                @Image(source: "xcode-new-project-template.png", alt: "Xcode의 새 프로젝트 템플릿 선택 화면")
            }

            @Step {
                **Product Name**을 `SolarSystem`으로 지정합니다. **Initial Scene**은
                `Window`, **Immersive Space Renderer**는 `RealityKit`, **Immersive Space**는
                `Mixed`로 선택합니다. 저장한 뒤 **TARGETS ▸ SolarSystem ▸ General ▸
                Minimum Deployments**가 **visionOS 26.0 이상**인지 확인합니다.
                @Image(source: "xcode-new-project-options.png", alt: "제품 이름과 초기 장면, 몰입 공간 방식을 고르는 화면")

                여기서 고른 값은 `Info.plist`의 초기 몰입 스타일일 뿐입니다. 실제 스타일은
                4챕터에서 `immersionStyle(selection:in:)`으로 `.full`을 지정해 결정합니다.
            }

            @Step {
                프로젝트 안에 `Model`, `Entities`, `Systems`, `RealityViews`,
                `Solar System` 폴더를 만듭니다. 이후 챕터에서 파일을 여기에 나눠 담습니다.
                @Image(source: "diagram-assets-folder.svg", alt: "다섯 개의 폴더로 나뉜 프로젝트 구조")
            }

            @Step {
                템플릿이 만든 `ContentView.swift`, `ImmersiveView.swift`,
                `AppModel.swift`, `ToggleImmersiveSpaceButton.swift` 네 개를 선택해
                **Move to Trash**로 지웁니다. 지운 자리는 `AppModel`과 `SwitchWindows`
                (3챕터), `SolarSystem`과 `ToggleImmersiveSpaceButton`(4챕터)이
                대신합니다.
                @Image(source: "diagram-assets-folder.svg", alt: "템플릿 기본 파일을 지운 뒤의 프로젝트 구조")
            }

            @Step {
                방금 지운 두 뷰를 `SolarSystemApp.swift`가 아직 참조하고 있으므로, 그
                내용을 창 하나만 띄우는 최소 형태로 바꿉니다. 4챕터에서 이 파일을 다시
                열어 조각들을 이어 붙입니다.
                @Code(name: "SolarSystemApp.swift", file: "01-01-SolarSystemApp.swift")

                이 단계를 건너뛰면 다음 섹션 마지막의 빌드가
                `Cannot find 'ContentView' in scope`로 실패합니다.
            }
        }
    }

    @Section(title: "모델 패키지와 이미지 연결하기") {
        @ContentAndMedia {
            이 페이지 위쪽의 **Project files** 버튼에서 `SolarSystem-Assets.zip`을
            내려받아 압축을 풉니다. 약 304MB입니다.

            안에는 로컬 Swift 패키지 `WorldAssets`(태양·지구·달·인공위성·나머지 일곱 행성
            모델), 조명용 `Sunlight.skybox`, 이미지 세 개가 들어 있습니다.

            @Image(source: "diagram-asset-bundle.svg", alt: "내려받은 폴더 안에 패키지와 이미지가 들어 있는 모습")
        }

        @Steps {
            @Step {
                Finder에서 `SolarSystem.xcodeproj`가 있는 프로젝트 폴더를 열고, 그 안에
                `Packages` 폴더를 만듭니다. 내려받은 `WorldAssets` 폴더 전체를 그리로
                복사합니다.
                @Image(source: "diagram-package-location.svg", alt: "프로젝트 폴더 아래 Packages 폴더에 패키지가 놓인 구조")

                최종 위치는 `프로젝트 폴더/Packages/WorldAssets/Package.swift`입니다.
            }

            @Step {
                Xcode의 **File ▸ Add Package Dependencies**를 열고 **Add Local**을 누른 뒤,
                방금 복사한 `Packages/WorldAssets` 폴더를 선택합니다.
                @Image(source: "xcode-select-package-folder.png", alt: "로컬 패키지 폴더를 고르는 화면")

                `Package.swift`가 들어 있는 `WorldAssets` 폴더를 고릅니다. 그 안의
                `Sources`나 `.rkassets`를 고르는 단계가 아닙니다.
            }

            @Step {
                패키지 제품으로 **WorldAssets**를 선택하고 **Add to Target**을
                **SolarSystem** 앱 타깃으로 지정해 추가합니다.
                @Image(source: "xcode-package-target.png", alt: "패키지 제품을 앱 타깃에 추가하는 화면")

                이후 코드에서 `import WorldAssets`와 `worldAssetsBundle`을 씁니다. 이
                패키지에는 `SunPositionSystem`도 들어 있습니다.
            }

            @Step {
                앱의 **Assets** 에셋 카탈로그를 열고, 내려받은 `Images` 폴더의
                `Starfield`, `SolarSystem`, `SolarBackground` 이미지 세트를 드래그해
                넣습니다.
                @Image(source: "xcode-assets-starfield.png", alt: "에셋 카탈로그에 별 배경 이미지를 추가한 화면")

                이름을 정확히 맞춰야 합니다. `Starfield`는 별 배경이,
                `SolarSystem`과 `SolarBackground`는 창 카드가 이름으로 찾아 씁니다.
            }

            @Step {
                내려받은 `Resources/Sunlight.skybox` 폴더를 프로젝트의 `Resources`
                폴더로 끌어다 놓고, **Add to targets**에서 **SolarSystem**을 체크합니다.
                @Image(source: "diagram-asset-bundle.svg", alt: "조명 이미지가 프로젝트 리소스에 추가된 모습")
            }

            @Step {
                실행 대상을 **Apple Vision Pro 시뮬레이터**로 고르고 **Command + B**로
                빌드합니다. 오류 없이 끝나면 준비가 끝났습니다.
                @Image(source: "xcode-package-linked.png", alt: "패키지가 앱 타깃에 연결된 것을 확인하는 화면")

                `No such module 'WorldAssets'`가 나오면 패키지 제품이 앱 타깃에
                연결되어 있는지 확인하세요. 여기서 빌드가 깨끗하게 끝나야 다음으로
                넘어갑니다.
            }
        }
    }

    @Section(title: "함께 쓰는 파일 배치하기") {
        @ContentAndMedia {
            다음 챕터부터 나오는 **Project files**에는 `SolarSystem-SupportFiles.zip`이
            들어 있습니다. 설정값과 문구만 담겨 새로 배울 개념이 없는 파일들이라, 한 줄씩
            따라 쓰지 않고 그대로 받아 씁니다.

            이 파일들은 다음 챕터에서 직접 만들 `PlanetEntity`를 참조하므로, 지금
            옮겨 두면 2챕터를 끝낼 때 전체 빌드가 처음으로 통과합니다.

            @Image(source: "diagram-assets-folder.svg", alt: "폴더별로 나뉜 함께 쓰는 파일 목록")
        }

        @Steps {
            @Step {
                2챕터 페이지의 **Project files**에서 `SolarSystem-SupportFiles.zip`을
                내려받아 압축을 풉니다. 안의 `README.txt`에 어떤 파일을 직접 쓰고 어떤
                파일을 받아 쓰는지 정리되어 있습니다.
                @Image(source: "diagram-asset-bundle.svg", alt: "압축을 푼 함께 쓰는 파일 폴더")
            }

            @Step {
                `Model`, `Entities`, `Systems`, `RealityViews`, `Solar System` 폴더의
                내용을 프로젝트의 같은 이름 폴더로 옮깁니다. 단 `Solar
                System/SolarSystemControls.swift` **하나만 빼 두세요.** 이 파일은
                4챕터에서 만드는 `ToggleImmersiveSpaceButton`을 쓰기 때문에, 지금 넣으면
                2·3챕터 내내 빌드가 깨집니다. 4챕터에서 다시 꺼내 씁니다.
                @Image(source: "diagram-package-location.svg", alt: "폴더 구조를 그대로 옮긴 모습")

                이 상태에서는 아직 빌드되지 않습니다. 방금 옮긴 파일들이 2챕터에서 만들
                `PlanetEntity`와 `RotationComponent`를 참조하기 때문입니다. 2챕터를
                끝내면 통과합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            최소 배포 대상을 visionOS 26.0 이상으로 맞춰야 하는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                `RealityView`가 visionOS 26부터 제공되기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    `RealityView`는 visionOS 1.0부터 있었습니다.
                }
            }

            @Choice(isCorrect: true) {
                `SpatialContainer`와 `depthAlignment` 같은 Spatial Layout API가 visionOS 26부터 제공되기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    3챕터에서 창 UI를 만들 때 이 API들을 씁니다. 배포 대상이 낮으면 그 코드가 컴파일되지 않습니다.
                }
            }

            @Choice(isCorrect: false) {
                로컬 Swift 패키지가 visionOS 26부터 지원되기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    로컬 패키지는 버전과 무관하게 쓸 수 있습니다.
                }
            }
        }
    }
}
