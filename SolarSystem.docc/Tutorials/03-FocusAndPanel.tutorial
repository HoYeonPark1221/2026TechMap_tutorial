@Tutorial(time: 30, projectFiles: "SolarSystem-SupportFiles.zip") {
    @XcodeRequirement(title: "Xcode 26 이상, visionOS 26 SDK", destination: "https://developer.apple.com/xcode/")

    @Intro(title: "보고, 집고, 불러오기") {
        행성을 바라보고 손가락을 맞대면 그 행성이 앞으로 다가와 설명 패널과 나란히
        서도록 만듭니다.

        시선과 핀치를 받는 방법, 엔티티를 순간이동 없이 다른 부모로 옮기는 방법,
        SwiftUI 뷰를 3차원 공간에 붙이는 방법을 차례로 다룹니다. 마지막에는 창 쪽 UI를
        visionOS 26의 Spatial Layout API로 만듭니다.
    }

    @Section(title: "시선과 핀치로 행성 선택하기") {
        @ContentAndMedia {
            visionOS에서는 손 추적 코드를 직접 쓰지 않아도 됩니다. 엔티티에 컴포넌트
            세 개를 붙이면 시스템이 시선 하이라이트와 핀치 선택을 알아서 처리합니다.

            `CollisionComponent`는 시선 광선이 맞을 형태를, `InputTargetComponent`는
            입력 대상으로 등록할지를, `HoverEffectComponent`는 바라볼 때의 하이라이트를
            담당합니다. 셋 중 하나라도 빠지면 반응하지 않습니다.

            @Image(source: "app-solarsystem.png", alt: "궤도를 도는 행성들 가운데 하나가 시선 하이라이트로 밝아진 화면")
        }

        @Steps {
            @Step {
                `Entities` 폴더에 `PlanetSelectionComponent.swift`를 만듭니다. 제스처가
                들어왔을 때 "어느 행성인지" 되찾기 위한 꼬리표 역할만 하는 컴포넌트입니다.
                @Code(name: "PlanetSelectionComponent.swift", file: "03-01-PlanetSelectionComponent.swift")
            }

            @Step {
                `PlanetEntity`에 보이지 않는 `selectionTarget` 엔티티를 추가하고, 위의
                꼬리표와 입력용 컴포넌트 세 개를 붙입니다.
                @Code(name: "PlanetEntity.swift", file: "03-02-PlanetEntity.swift", previousFile: "02-09-PlanetEntity.swift")

                모델에 직접 붙이지 않고 별도 엔티티로 두는 이유는, 지구의 `EarthEntity`가
                자기 하위 엔티티에 콜라이더를 갖고 있어서 그쪽이 탭을 먼저 가로채기
                때문입니다.
            }

            @Step {
                `Model` 폴더에 `AppModel.swift`를 만들어 "지금 선택된 행성"을 담습니다.
                한 행성이 선택되면 나머지는 전부 숨깁니다.
                @Code(name: "AppModel.swift", file: "03-03-AppModel.swift")

                `@Observable`을 붙였으므로, 이 값이 바뀌면 이 값을 읽는 모든 뷰가 다시
                그려집니다.
            }

            @Step {
                `RealityViews` 폴더에 `Planet.swift`를 만듭니다. `RealityView`가 행성
                엔티티를 만들어 장면에 넣고, 설정이 바뀔 때마다 갱신합니다.
                @Code(name: "Planet.swift", file: "03-04-Planet.swift")
            }

            @Step {
                `SpatialTapGesture`를 붙입니다. `targetedToAnyEntity()`로 어떤 엔티티든
                받아 놓은 뒤, 우리가 붙인 꼬리표가 있는지로 걸러냅니다.
                @Code(name: "Planet.swift", file: "03-05-Planet.swift", previousFile: "03-04-Planet.swift")

                이래야 궤도선이나 배경을 집었을 때 반응하지 않습니다.
            }

            @Step {
                **Command + B**로 빌드합니다. 2챕터 끝에 이어 두 번째로 통과하는
                지점입니다. 이 섹션에서 파일 네 개를 새로 만들었으니, 여기서 한 번
                걸러 두면 남은 네 섹션에서 나올 오류와 섞이지 않습니다.
            }
        }
    }

    @Section(title: "부모를 바꿔 앞으로 불러오기") {
        @ContentAndMedia {
            선택된 행성은 궤도 어디에 있든 늘 같은 자리, 같은 크기로 나타나야 합니다.
            그러려면 행성을 공용 무대로 옮겨야 하는데, 그냥 옮기면 순간이동해 버립니다.

            `addChild(_:preservingWorldTransform: true)`는 부모만 바꾸고 화면상 위치는
            그대로 둡니다. 그 다음 `move(to:)`로 목적지까지 이어 주면, 행성이 있던
            자리에서 무대까지 자연스럽게 날아옵니다.

            @Image(source: "app-focus-mars.png", alt: "행성 하나가 궤도에서 빠져나와 정면으로 확대된 화면")
        }

        @Steps {
            @Step {
                `RealityViews` 폴더에 `FocusStage.swift`를 만듭니다. 선택된 행성과 패널이
                모여드는, 장면에 단 하나뿐인 무대입니다.
                @Code(name: "FocusStage.swift", file: "03-06-FocusStage.swift")

                완전 몰입 공간에는 기본 조명이 없습니다. 유일한 광원인 태양이 무대 훨씬
                뒤에 있어서, 보는 사람 쪽에서 비추는 키 라이트를 따로 답니다.
            }

            @Step {
                `PlanetEntity`에 포커스 상태와 크기 상수를 추가합니다. 어떤 행성이든
                선택되면 똑같은 크기가 되어야, 작은 수성과 거대한 목성이 둘 다 한눈에
                읽힙니다.
                @Code(name: "PlanetEntity.swift", file: "03-07-PlanetEntity.swift", previousFile: "03-02-PlanetEntity.swift")

                `focusPanelOffset`은 다음 섹션에서 설명 패널을 놓을 자리입니다. 행성
                반지름 + 사이 여백 + 패널 절반 너비를 더한 값입니다.
            }

            @Step {
                `setFocused(_:stage:animated:)`를 추가합니다. 부모를 바꾼 뒤 목표 위치로
                0.6초에 걸쳐 이동시키고, 포커스 중에는 공전을 멈춥니다.
                @Code(name: "PlanetEntity.swift", file: "03-08-PlanetEntity.swift", previousFile: "03-07-PlanetEntity.swift")

                무대로 옮기는 것은 `equatorialPlane`입니다. 자전축 기울기를 그대로 가져가되
                공전과 궤도 거리에서는 떨어져 나오게 하려는 것입니다.
            }

            @Step {
                **Command + B**로 빌드합니다. `FocusStage`와 `PlanetEntity`의 변경이
                서로 맞물리는 자리라, 한쪽 시그니처만 어긋나도 여기서 바로 드러납니다.
            }
        }
    }

    @Section(title: "SwiftUI 패널을 3차원 공간에 붙이기") {
        @ContentAndMedia {
            `RealityView`의 `attachments` 블록에 넣은 평범한 SwiftUI 뷰는 엔티티가 되어
            3차원 좌표에 놓입니다. 글자와 버튼을 RealityKit으로 다시 만들 필요가 없습니다.

            여기서 필요한 감각이 포인트와 미터의 환산입니다. 패널은 760포인트 너비인데
            공간에서는 약 0.56미터입니다. 행성 반지름 + 사이 여백 + 패널 절반 너비를
            더해야 둘이 겹치지 않고 나란히 섭니다.

            @Image(source: "app-focus-mars.png", alt: "확대된 행성 오른쪽에 유리 재질 설명 패널이 나란히 놓인 화면")
        }

        @Steps {
            @Step {
                `Planet`에 `attachments` 블록을 더하고, 포커스 상태일 때 패널을 무대에
                붙여 행성 오른쪽에 놓습니다.
                @Code(name: "Planet.swift", file: "03-09-Planet.swift", previousFile: "03-05-Planet.swift")

                `PlanetInfoPanel`은 평범한 SwiftUI 뷰라 내려받은 파일에 들어 있습니다.
                간격 계산에 쓰는 상수들은 `PlanetEntity`에 정의해 두었습니다.
            }
        }
    }

    @Section(title: "시선 정면에 무대 놓기") {
        @ContentAndMedia {
            지금까지는 무대가 `FocusStage`의 고정 좌표에 있습니다. 행성들은 태양을 중심으로
            반지름 7.8미터까지 퍼져 있어서, 바깥쪽 행성을 집으려면 몸을 돌려야 합니다.
            그 상태에서 확대된 행성이 정면 고정 위치에 뜨면 시야 밖입니다.

            그래서 핀치하는 순간 머리 위치를 읽어 무대를 눈앞으로 옮깁니다. 머리 추적은
            함께 내려받은 `HeadTracker.swift`가 ARKit으로 처리하므로, 여기서는 그 값을
            받아 무대를 놓는 계산만 작성합니다.

            @Image(source: "app-focus-mars.png", alt: "바라보던 방향 정면에 행성과 패널이 나타난 화면")
        }

        @Steps {
            @Step {
                `AppModel`에 머리 추적기와 배치 계산을 추가합니다. 4x4 행렬에서 위치는
                4번째 열, 앞방향은 3번째 열의 부호를 뒤집어 얻습니다.
                @Code(name: "AppModel.swift", file: "03-10-AppModel.swift", previousFile: "03-03-AppModel.swift")

                앞방향의 `y`를 0으로 눌러 수평만 남기는 한 줄이 중요합니다. 이게 없으면
                위를 올려다보며 핀치할 때 무대가 비스듬히 기웁니다.
            }

            @Step {
                `Planet`의 제스처에서, 포커스가 **처음 열릴 때만** 무대를 옮깁니다.
                @Code(name: "Planet.swift", file: "03-11-Planet.swift", previousFile: "03-09-Planet.swift")

                `focusedPlanetID == nil` 조건이 핵심입니다. 이미 포커스 중에 이전/다음
                버튼을 누를 때마다 무대가 따라다니면 행성이 매번 다른 자리에서 나타납니다.
            }

            @Step {
                **Command + B**로 빌드합니다. 몰입 공간 쪽 코드는 여기서 끝이라, 이번이
                마지막으로 깨끗하게 통과하는 지점입니다. 다음 섹션부터는 4챕터에서
                채워질 자리를 참조하기 시작합니다.
            }
        }
    }

    @Section(title: "Spatial Layout으로 창 UI 만들기") {
        @ContentAndMedia {
            visionOS 26에서 SwiftUI의 레이아웃 개념이 깊이를 갖도록 확장되었습니다.
            지금까지 x·y만 있던 정렬 기준에 z가 더해지고, 뷰를 같은 공간에 겹쳐 두는
            전용 컨테이너가 생겼습니다.

            핵심은 **레이아웃에 반영되는가, 겉모습만 바뀌는가**의 구분입니다.
            `SpatialContainer`와 `depthAlignment`는 레이아웃이 실제로 계산하는 값을
            바꿉니다. 창 UI를 만들면서 각각이 어떤 상황을 위한 것인지 확인합니다.

            @Image(source: "app-starfield.png", alt: "우주 배경 앞에 떠 있는 창 UI")
        }

        @Steps {
            @Step {
                `Solar System` 폴더에 `SwitchWindows.swift`를 만듭니다. 두 뷰를 같은
                3차원 공간에 겹쳐 두고 불투명도로 교차시키는 자리이므로
                `SpatialContainer`를 씁니다.
                @Code(name: "SwitchWindows.swift", file: "03-12-SwitchWindows.swift")

                `alignment`에는 기본값이 없어서 반드시 적어야 합니다. `.center`는 평면이
                아니라 깊이까지 포함하는 `Alignment3D` 값입니다.
            }

            @Step {
                같은 폴더에 `SolarCard.swift`를 만듭니다. 왼쪽 글과 오른쪽 미리보기를
                가로로 놓되, 앞뒤 기준을 주려고 `HStackLayout`에 `depthAlignment(.center)`를
                겁니다.
                @Code(name: "SolarCard.swift", file: "03-13-SolarCard.swift")

                `depthAlignment`는 뷰가 아니라 `Layout` 프로토콜을 따르는 값에만 걸 수
                있습니다. 그래서 `HStack`이 아니라 `HStackLayout`입니다.
            }

            @Step {
                지금 빌드하면 `Cannot find 'SolarSystemControls' in scope`가 납니다.
                정상입니다. `SwitchWindows`가 쓰는 `SolarSystemControls`는 1챕터에서
                일부러 빼 둔 파일이고, 그 파일이 다시 필요로 하는
                `ToggleImmersiveSpaceButton`을 4챕터 첫 섹션에서 만듭니다. 거기서 둘을
                한꺼번에 넣으면 다시 통과합니다.

                이 오류 **하나만** 남아 있는지 확인하세요. 다른 오류가 함께 보인다면 그건
                이 섹션에서 만든 두 파일의 문제이므로 지금 잡고 넘어갑니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            `addChild(_:preservingWorldTransform: true)`가 하는 일은 무엇인가요?

            @Choice(isCorrect: false) {
                자식의 변환을 초기화해 부모의 원점에 붙입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    그것은 `preservingWorldTransform`을 `false`로 두었을 때의 동작에 가깝습니다.
                }
            }

            @Choice(isCorrect: true) {
                부모만 바꾸고, 화면상 위치와 방향은 그대로 유지합니다.

                @Justification(reaction: "맞습니다!") {
                    그래서 옮기는 순간 순간이동이 일어나지 않고, 이어지는 `move(to:)`가 제자리에서 목적지까지 부드럽게 연결합니다.
                }
            }

            @Choice(isCorrect: false) {
                자식을 복제해 두 부모 모두에 붙입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    엔티티의 부모는 언제나 하나뿐이며, 복제도 일어나지 않습니다.
                }
            }
        }

        @MultipleChoice {
            `depthAlignment`를 `HStack`에 직접 걸 수 없는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                `HStack`은 가로 방향만 다루므로 깊이 개념이 없기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    `HStackLayout`도 같은 가로 배치를 하지만 `depthAlignment`를 걸 수 있습니다.
                }
            }

            @Choice(isCorrect: true) {
                `depthAlignment`는 `Layout` 프로토콜을 따르는 값에만 쓸 수 있는데, `HStack`은 뷰이기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    그래서 같은 배치를 `Layout` 값으로 표현하는 `HStackLayout`으로 바꾼 뒤 `depthAlignment`를 겁니다.
                }
            }

            @Choice(isCorrect: false) {
                `HStack` 안에 3차원 콘텐츠를 넣을 수 없기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    넣을 수 있습니다. 문제는 깊이 정렬 기준을 지정할 방법이 없다는 점입니다.
                }
            }
        }
    }
}
