@Tutorial(time: 15, projectFiles: "SolarSystem-SupportFiles.zip") {
    @XcodeRequirement(title: "Xcode 26 이상, visionOS 26 SDK", destination: "https://developer.apple.com/xcode/")

    @Intro(title: "하나의 앱으로 조립하기") {
        지금까지 만든 조각들은 서로를 직접 알지 못합니다. `PlanetEntity`도 `Planet`도
        `SwitchWindows`도, 누가 자신을 화면에 올리는지 모릅니다.

        이 챕터에서 `@main` 진입점을 만들어 전부 이어 붙입니다. 창과 몰입 공간을 Scene
        으로 등록하고, 둘이 같은 상태를 나눠 보게 만들고, 1챕터에서 만든 시스템을
        등록합니다.
    }

    @Section(title: "창과 몰입 공간을 잇는 상태 만들기") {
        @ContentAndMedia {
            창과 몰입 공간은 서로 다른 Scene이라 직접 대화하지 못합니다. 같은
            `@Observable` 객체 하나를 양쪽에 주입해야 한쪽의 변화가 다른 쪽에 비칩니다.

            그리고 몰입 공간을 여닫는 일은 `await`라서 시간이 걸립니다. 그 사이에 버튼이
            또 눌리면 상태가 꼬이므로, "열림"과 "닫힘" 사이에 "전환 중"이라는 중간 상태를
            둡니다.

            @Image(source: "diagram-asset-bundle.svg", alt: "창과 몰입 공간이 같은 상태 객체를 공유하는 구조도")
        }

        @Steps {
            @Step {
                3챕터에서 만든 `AppModel`에 몰입 공간 관련 상태를 더합니다.
                `immersiveSpaceID`는 나중에 공간을 열고 닫을 때 쓰는 이름입니다.
                @Code(name: "AppModel.swift", file: "04-01-AppModel.swift", previousFile: "03-10-AppModel.swift")

                `inTransition`이 없으면 전환이 끝나기 전에 버튼을 다시 눌렀을 때 공간이
                두 번 열리거나 상태가 어긋납니다.
            }

            @Step {
                `Solar System` 폴더에 `SolarSystem.swift`를 만들어 몰입 공간에 들어갈
                내용을 한자리에 쌓습니다. 여기서 `FocusStage`가 만든 무대를 모든
                `Planet`에게 나눠 줍니다.
                @Code(name: "SolarSystem.swift", file: "04-02-SolarSystem.swift")

                `Starfield`와 `Sun`은 내려받은 파일에 들어 있습니다. 머리 추적은 몰입
                공간이 열려 있는 동안만 데이터가 오므로 여기서 시작하고 멈춥니다.
            }

            @Step {
                같은 폴더에 `ToggleImmersiveSpaceButton.swift`를 만듭니다. 상태에 따라
                여닫기를 나눠 처리하고, 전환 중에는 버튼을 잠급니다.
                @Code(name: "ToggleImmersiveSpaceButton.swift", file: "04-03-ToggleImmersiveSpaceButton.swift")

                여기 쓰는 `model.immersiveSpaceID`는 다음 섹션에서 선언할
                `ImmersiveSpace(id:)`와 반드시 같은 값이어야 합니다.
            }

            @Step {
                1챕터에서 빼 두었던 `SolarSystemControls.swift`를 이제 프로젝트의
                `Solar System` 폴더로 옮깁니다. 이 파일이 기다리던
                `ToggleImmersiveSpaceButton`을 방금 만들었습니다.

                **Command + B**로 빌드합니다. 3챕터 마지막에 남겨 둔
                `Cannot find 'SolarSystemControls' in scope`가 사라지고 전체가 통과해야
                합니다.
            }
        }
    }

    @Section(title: "@main 진입점에서 전부 잇기") {
        @ContentAndMedia {
            `@main`이 붙은 구조체는 앱에 단 하나뿐입니다. 지금까지 만든 조각들이 여기서
            처음으로 한자리에 모입니다.

            창은 `SwitchWindows`가, 몰입 공간은 `SolarSystem`이 그립니다. 둘 다 같은
            `AppModel`을 받아 보고, 마지막으로 1챕터에서 만든 `RotationSystem`을
            등록하면 행성이 비로소 움직이기 시작합니다.

            @Image(source: "app-solarsystem.png", alt: "완성된 태양계가 눈앞에 펼쳐진 화면")
        }

        @Steps {
            @Step {
                1챕터에서 창 하나만 띄워 두었던 `SolarSystemApp.swift`를 다시 엽니다.
                `WindowGroup` 안의 자리 표시용 `Text`를 `SwitchWindows`로 바꿉니다.
                @Code(name: "SolarSystemApp.swift", file: "04-04-SolarSystemApp.swift", previousFile: "01-01-SolarSystemApp.swift")

                아직 `AppModel`을 주입하지 않아, 이 상태로 빌드하면 환경값을 찾지 못해
                실행 중에 멈춥니다.
            }

            @Step {
                `AppModel`을 `@State`로 딱 한 번 만들고 `.environment(model)`로 창에
                주입합니다. 이제 `SwitchWindows`와 그 하위 뷰들이 같은 인스턴스를 봅니다.
                @Code(name: "SolarSystemApp.swift", file: "04-05-SolarSystemApp.swift", previousFile: "04-04-SolarSystemApp.swift")
            }

            @Step {
                `ImmersiveSpace` Scene을 추가하고 똑같이 `model`을 주입한 뒤, 몰입
                스타일을 `.full`로 지정합니다.
                @Code(name: "SolarSystemApp.swift", file: "04-06-SolarSystemApp.swift", previousFile: "04-05-SolarSystemApp.swift")

                여기 쓴 `id`가 `ToggleImmersiveSpaceButton`이 `openImmersiveSpace(id:)`에
                넘기는 값과 같아야 합니다. 다르면 아무 오류 없이 그냥 열리지 않습니다.
            }

            @Step {
                `init()`에서 직접 만든 시스템 셋을 등록합니다. 이 줄들이 없으면 컴파일도
                되고 크래시도 나지 않지만, 행성이 전혀 움직이지 않습니다.
                @Code(name: "SolarSystemApp.swift", file: "04-07-SolarSystemApp.swift", previousFile: "04-06-SolarSystemApp.swift")

                이제 앱을 실행해 창의 버튼으로 태양계를 열고, 행성을 바라보며 손가락을
                맞대 보세요.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            창과 몰입 공간이 같은 상태를 나눠 보게 만드는 방법은 무엇인가요?

            @Choice(isCorrect: false) {
                두 Scene 안에서 각각 `AppModel()`을 새로 만듭니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    그러면 서로 다른 인스턴스가 두 개 생겨서, 한쪽의 변화가 다른 쪽에 전혀 전달되지 않습니다.
                }
            }

            @Choice(isCorrect: true) {
                `@main`에서 한 번 만든 인스턴스를 양쪽 Scene에 `.environment(model)`로 주입합니다.

                @Justification(reaction: "맞습니다!") {
                    인스턴스가 하나뿐이어야 창에서 연 몰입 공간이 창의 상태를 그대로 따라갑니다.
                }
            }

            @Choice(isCorrect: false) {
                `ImmersiveSpace`가 `WindowGroup`의 하위 뷰이므로 자동으로 상속됩니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    두 Scene은 서로 독립적이며 상하 관계가 아닙니다.
                }
            }
        }

        @MultipleChoice {
            `RotationSystem.registerSystem()`을 빼먹으면 어떤 일이 생기나요?

            @Choice(isCorrect: false) {
                컴파일 오류가 납니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    등록은 실행 시점의 일이라 컴파일러는 아무 문제를 찾지 못합니다.
                }
            }

            @Choice(isCorrect: false) {
                앱이 시작하자마자 크래시가 납니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    크래시도 나지 않습니다. 그래서 더 찾기 어렵습니다.
                }
            }

            @Choice(isCorrect: true) {
                아무 오류 없이 앱이 실행되지만, 행성이 전혀 움직이지 않습니다.

                @Justification(reaction: "맞습니다!") {
                    시스템이 등록되지 않으면 `RotationComponent`를 아무리 붙여도 그 값을 읽어 줄 코드가 없습니다. 조용히 실패하는 대표적인 경우입니다.
                }
            }
        }
    }
}
