@Tutorial(time: 20, projectFiles: "SolarSystem-SupportFiles.zip") {
    @XcodeRequirement(title: "Xcode 26 이상, visionOS 26 SDK", destination: "https://developer.apple.com/xcode/")

    @Intro(title: "행성 엔티티 만들기") {
        행성 하나는 두 가지로 동시에 움직입니다. 태양 주위를 도는 공전과, 기울어진 축을
        중심으로 제자리에서 도는 자전입니다.

        엔티티 하나에는 회전을 하나밖에 담을 수 없습니다. 그래서 역할마다 빈 엔티티를
        하나씩 두고 부모-자식으로 엮어, 부모의 변환이 자식에게 누적되는 성질을 이용합니다.
        움직임 자체는 컴포넌트와 시스템으로 나눠 맡깁니다.
    }

    @Section(title: "회전을 컴포넌트와 시스템으로 나누기") {
        @ContentAndMedia {
            RealityKit은 Entity–Component–System 구조로 되어 있습니다. 엔티티는 공간에
            놓인 물체, 컴포넌트는 그 물체가 가진 값, 시스템은 매 프레임 실제로 일하는
            코드입니다.

            "초당 몇 라디안으로 돈다"는 값은 컴포넌트에 담고, 그 값을 읽어 실제로
            돌리는 일은 시스템이 합니다. 이렇게 나눠 두면 같은 시스템 하나가 행성이든
            궤도 축이든 컴포넌트를 가진 모든 엔티티를 한꺼번에 처리합니다.

            @Image(source: "diagram-assets-folder.svg", alt: "컴포넌트는 값을 담고 시스템이 그 값을 읽어 움직이는 관계도")
        }

        @Steps {
            @Step {
                `Systems` 폴더에 `RotationSystem.swift`를 만들고, 회전 속도와 축을 담는
                `RotationComponent`를 정의합니다. 컴포넌트는 값을 들고 있을 뿐 스스로는
                아무 일도 하지 않습니다.
                @Code(name: "RotationSystem.swift", file: "02-01-RotationSystem.swift")
            }

            @Step {
                같은 파일에 `RotationSystem`을 추가합니다. `EntityQuery`가 이 시스템이
                매 프레임 상대할 엔티티의 조건, 즉 "`RotationComponent`를 가진 것 전부"를
                정의합니다.
                @Code(name: "RotationSystem.swift", file: "02-02-RotationSystem.swift", previousFile: "02-01-RotationSystem.swift")
            }

            @Step {
                `update(context:)`에서 조건에 맞는 엔티티를 훑으며 방향을 조금씩 돌립니다.
                `context.deltaTime`을 곱해야 프레임레이트가 달라져도 같은 속도로 돕니다.
                @Code(name: "RotationSystem.swift", file: "02-03-RotationSystem.swift", previousFile: "02-02-RotationSystem.swift")

                이 시스템은 아직 동작하지 않습니다. 직접 만든 시스템은 앱 시작 시 한 번
                등록해야 하는데, 그 코드는 4챕터의 `@main` 진입점에서 작성합니다.
            }

            @Step {
                `RotationSystem.swift`를 연 채로 **Product ▸ Perform Action ▸ Compile
                "RotationSystem.swift"**(⌃⌘B)를 실행해, 방금 쓴 파일만 따로
                컴파일해 봅니다.

                전체 빌드는 아직 통과하지 않습니다. 1챕터에서 옮겨 둔
                `PlanetEntity+Configuration.swift`가 다음 섹션에서 만들 `PlanetEntity`를
                기다리고 있기 때문입니다. 파일 단위 컴파일은 그 영향을 받지 않으므로,
                오타는 지금 바로 잡을 수 있습니다.
            }
        }
    }

    @Section(title: "빈 엔티티를 층층이 쌓기") {
        @ContentAndMedia {
            공전과 자전을 한 엔티티에 함께 넣을 수는 없습니다. 대신 역할이 하나씩인
            빈 엔티티를 네 개 만들어 부모-자식으로 잇습니다.

            바깥부터 공전(`orbitPivot`), 거리(`radiusOffset`), 축 기울기
            (`equatorialPlane`), 자전(`rotator`) 순입니다. 맨 안쪽에 모델을 매달면
            부모들의 변환이 차례로 누적되어 네 가지가 한꺼번에 적용됩니다.

            @Image(source: "diagram-planet-hierarchy.svg", alt: "orbitPivot에서 rotator까지 이어지는 엔티티 계층")
        }

        @Steps {
            @Step {
                `Entities` 폴더에 `PlanetEntity.swift`를 만들고, 역할별 빈 엔티티를
                선언합니다. 아직 아무것도 연결하지 않아 화면에는 변화가 없습니다.
                @Code(name: "PlanetEntity.swift", file: "02-04-PlanetEntity.swift")

                `planetID`라는 이름을 쓴 이유는 `Entity`가 이미 재정의할 수 없는
                `id` 속성을 갖고 있기 때문입니다.
            }

            @Step {
                초기화 메서드에서 `addChild`로 네 엔티티를 한 줄로 잇습니다. 이 순서가
                곧 변환이 누적되는 순서입니다.
                @Code(name: "PlanetEntity.swift", file: "02-05-PlanetEntity.swift", previousFile: "02-04-PlanetEntity.swift")
            }

            @Step {
                궤도선을 담을 `orbitPath`를 추가합니다. `orbitPivot`의 **자식이 아니라
                형제**로 두는 것이 핵심입니다. 자식으로 넣으면 궤도선까지 행성과 함께
                돌아버려서 경로가 보이지 않습니다.
                @Code(name: "PlanetEntity.swift", file: "02-06-PlanetEntity.swift", previousFile: "02-05-PlanetEntity.swift")

                RealityKit에는 고리 모양 기본 도형이 없어서 `makeRingMesh`가 삼각형을
                직접 쌓아 만듭니다. 앞뒤 양면을 모두 그려야 어느 쪽에서 봐도 보입니다.
            }

            @Step {
                태양계 전체의 중심과 기울기, 궤도 시작 각도, 자전축 기울기를 정합니다.
                모두 초기화 때 한 번만 설정하는 값입니다.
                @Code(name: "PlanetEntity.swift", file: "02-07-PlanetEntity.swift", previousFile: "02-06-PlanetEntity.swift")

                궤도 시작 각도를 나중에 다시 쓰면 갱신될 때마다 공전 진행도가 0으로
                되돌아갑니다.
            }

            @Step {
                모델을 불러와 가장 안쪽 `rotator`에 매답니다. 지구만 달과 인공위성을
                거느린 `EarthEntity`를 쓰고, 나머지 일곱은 이름이 같은 모델을 찾아
                옵니다.
                @Code(name: "PlanetEntity.swift", file: "02-08-PlanetEntity.swift", previousFile: "02-07-PlanetEntity.swift")

                `normalizedToUnitRadius`가 극-극(Y) 길이로 재는 이유는, 토성의 납작한
                고리가 반지름으로 계산되어 본체를 쪼그라뜨리지 않게 하기 위해서입니다.
            }

            @Step {
                `update(configuration:animateUpdates:)`에서 거리와 회전 속도를 맞춥니다.
                공전과 자전은 서로 다른 엔티티가 맡으므로, 같은 `RotationComponent`를
                각각 붙여 주기만 하면 됩니다.
                @Code(name: "PlanetEntity.swift", file: "02-09-PlanetEntity.swift", previousFile: "02-08-PlanetEntity.swift")

                여덟 행성의 크기·궤도·속도 설정값은 내려받은 파일의
                `PlanetEntity+Configuration.swift`에 들어 있습니다.
            }

            @Step {
                **Command + B**로 전체를 빌드합니다. 이번에는 통과해야 합니다. 1챕터에서
                옮겨 둔 파일들이 기다리던 `PlanetEntity`와 `RotationComponent`가 이제
                모두 갖춰졌기 때문입니다.

                화면에는 아직 아무것도 나오지 않습니다. 이 엔티티를 띄우는 뷰는 3챕터에서
                만듭니다. 여기서 오류가 남아 있다면 3챕터로 넘어가지 말고 먼저
                해결하세요. 다음 챕터는 다섯 섹션으로 가장 길어서, 지금 놓친 오류가
                거기까지 쌓입니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            `orbitPath`를 `orbitPivot`의 자식이 아니라 형제로 둔 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                자식으로 두면 궤도선이 화면에 보이지 않기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    보이지 않는 것이 아니라, 보이되 엉뚱하게 움직입니다.
                }
            }

            @Choice(isCorrect: true) {
                부모가 도는 변환이 자식에게 누적되어, 궤도선까지 행성과 함께 돌아버리기 때문입니다.

                @Justification(reaction: "맞습니다!") {
                    궤도선은 경로 자체를 보여 줘야 하므로 제자리에 있어야 합니다. 그래서 도는 엔티티의 바깥에 둡니다.
                }
            }

            @Choice(isCorrect: false) {
                한 엔티티는 자식을 하나만 가질 수 있기 때문입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    엔티티는 자식을 얼마든지 가질 수 있습니다.
                }
            }
        }

        @MultipleChoice {
            `RotationSystem`이 `context.deltaTime`을 곱하는 이유는 무엇인가요?

            @Choice(isCorrect: false) {
                회전 속도를 라디안에서 도(degree)로 바꾸기 위해서입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    단위 변환과는 관계가 없습니다. `speed`는 처음부터 라디안 단위입니다.
                }
            }

            @Choice(isCorrect: true) {
                프레임레이트가 달라져도 같은 속도로 돌게 하기 위해서입니다.

                @Justification(reaction: "맞습니다!") {
                    `deltaTime`은 지난 프레임에서 흐른 실제 시간입니다. 이 값을 곱하면 초당 회전량이 일정하게 유지됩니다.
                }
            }

            @Choice(isCorrect: false) {
                컴포넌트가 없는 엔티티를 걸러 내기 위해서입니다.

                @Justification(reaction: "다시 시도해 보세요.") {
                    그 일은 `EntityQuery`가 합니다.
                }
            }
        }
    }
}
